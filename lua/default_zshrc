copy() {
    if [[ -n "$1" ]]; then
        # File provided
        xclip -selection clipboard < "$1"
    else
        # Pipe provided
        xclip -selection clipboard
    fi
    echo "Copied to clipboard"
}

edge() {
    local winpath
    winpath=$(wslpath -w "$1")
    "$BROWSER" "$winpath" >/dev/null 2>&1 &
}

_use_java_21() {
  export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"
  path=($JAVA_HOME/bin ${path:#/usr/lib/jvm/java-*/bin})
}

_use_java_25() {
  export JAVA_HOME="/usr/lib/jvm/java-25-openjdk-amd64"
  path=($JAVA_HOME/bin ${path:#/usr/lib/jvm/java-*/bin})
}

_java-version() {
  echo "JAVA_HOME=$JAVA_HOME"
  java -version
}

# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
# alias copy="xclip -selection clipboard"
alias paste="xclip -selection clipboard -o"
alias cl="r 2>&1 | copy"
alias cdr='cd "$(git rev-parse --show-toplevel)"'
alias zshrc="code ~/.zshrc"
alias reload="source ~/.zshrc && exec zsh"
alias cat="bat --color=always --style=numbers"
GCM_MSG=$'Can you write me a conventional commit message for the below git diff,
ensure it is in markdown and use the imperative, present tense.
When generating commit message bodies, please wrap the text at 72 characters.'
alias gdc='{ echo "$GCM_MSG"; git diff --staged; } | copy'
alias cd="z"
alias fzopen='fzf --preview="bat --color=always --style=numbers --line-range=:500 {}" --bind "enter:become(code {})"'

alias m='make'

alias use-java-21='_use_java_21'
alias use-java-25='_use_java_25'
alias java-version='_java-version'

