# If you come from bash you might have to change your $PATH.
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export ZSH_HIGHLIGHT_HIGHLIGHTERS_DIR=/home/linuxbrew/.linuxbrew/share/zsh-syntax-highlighting/highlighters

export EDITOR=code
# export BROWSER="/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"
export BROWSER="/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"

export LANG=en_US.UTF-8
export LANGUAGE=en_US:en
export LC_ALL=en_US.UTF-8

export COLORTERM=truecolor

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# Recommended history behavior
setopt HIST_IGNORE_DUPS         # Don't store duplicate lines
setopt HIST_IGNORE_ALL_DUPS     # Remove older duplicate commands
setopt HIST_REDUCE_BLANKS       # Trim extra whitespace
setopt EXTENDED_HISTORY         # Include timestamps

# Real-time syncing between sessions
# setopt INC_APPEND_HISTORY       # Immediately append to $HISTFILE
# setopt SHARE_HISTORY            # Import history from other sessions

# Disable real-time cross-session history syncing
unsetopt INC_APPEND_HISTORY      # DO NOT write history immediately
unsetopt SHARE_HISTORY           # DO NOT import history immediately

# Append ONLY when shell exits (session-isolated)
setopt APPEND_HISTORY           # Append, don't overwrite

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
autoload -Uz compinit
compinit

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# dircolors ~/.dircolors

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

